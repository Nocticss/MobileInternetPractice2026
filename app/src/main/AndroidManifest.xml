<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.mobileinternetpractice">

    <!-- 基础网络权限 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- 网络状态权限（城市切换所需） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- 读取相册权限（修改背景图所需，适配不同Android版本） -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"
        android:minSdkVersion="33"/>

    <!-- 应用核心配置（合并重复的application标签，添加cleartextTraffic） -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MobileInternetPractice"
        android:usesCleartextTraffic="true"> <!-- 移到正确位置，解决Android 9+明文请求问题 -->

        <!-- 启动页（程序入口） -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 登录页 -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:label="登录"/>

        <!-- 注册页 -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <!-- 主页 -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"/>

        <!-- 功能页（吃/穿/玩） -->
        <activity
            android:name=".FunctionActivity"
            android:exported="false" />

        <!-- 我的菜单页 -->
        <activity
            android:name=".MenuActivity"
            android:exported="false" />

        <!-- 添加菜品页 -->
        <activity
            android:name=".AddFoodActivity"
            android:exported="false" />

        <!-- 个人中心页 -->
        <activity
            android:name=".UserCenterActivity"
            android:exported="false" />

        <!-- 添加穿/玩菜单页 -->
        <activity
            android:name=".AddMenuActivity"
            android:exported="false" />

        <!-- 穿/玩菜单展示页 -->
        <activity
            android:name=".MenuWearPlayActivity"
            android:exported="false" />

    </application>

</manifest>