<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_soft1">

    <!-- 左上角历史记录按钮 -->
    <Button
        android:id="@+id/btn_history"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="历史记录"
        android:layout_gravity="start|top"
        android:layout_margin="16dp"
        android:background="#F5F5F5"
        android:textColor="#333333"/>

    <!-- 历史记录面板（可滑动 + 清除按钮）-->
    <LinearLayout
        android:id="@+id/ll_history_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F8F8F8"
        android:padding="15dp"
        android:visibility="gone"
        android:layout_marginHorizontal="16dp">

        <!-- 可滑动的历史记录区域 -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:overScrollMode="never">

            <TextView
                android:id="@+id/tv_history_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="暂无历史记录"
                android:textSize="16sp"/>

        </ScrollView>

        <!-- 清除历史记录按钮 -->
        <Button
            android:id="@+id/btn_clear_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="清除历史记录"
            android:layout_marginTop="10dp"
            android:background="#E53935"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

    <!-- 标题 -->
    <TextView
        android:id="@+id/tv_main_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="选择困难症决定器"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_gravity="center"
        android:layout_marginBottom="15dp"/>

    <!-- 天气模块 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#0066CC"
        android:padding="10dp"
        android:elevation="5dp"
        android:layout_marginBottom="10dp">
        <TextView
            android:id="@+id/tv_weather"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="加载中..."
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:gravity="center"/>
        <TextView
            android:id="@+id/tv_temperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="加载中..."
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:gravity="center"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical">
        <Button
            android:id="@+id/btn_change_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="更换背景"
            android:background="#F5F5F5"
            android:textColor="#333333"/>
    </LinearLayout>

    <!-- 用户名 -->
    <TextView
        android:id="@+id/tv_user"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="22sp"
        android:textColor="#333333"
        android:padding="12dp"
        android:layout_marginTop="15dp"
        android:gravity="center"
        android:textStyle="bold"/>

    <!-- 骰子 + 金币 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="25dp">

        <ImageView
            android:id="@+id/iv_dice"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_dice"/>
        <Button
            android:id="@+id/btn_dice"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:text="骰子"
            android:textSize="22sp"
            android:layout_marginRight="25dp"
            android:background="#0066CC"
            android:textColor="#FFFFFF"
            android:elevation="5dp"/>
        <TextView
            android:id="@+id/tv_dice_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="28sp"
            android:textColor="#0066CC"
            android:layout_marginRight="25dp"
            android:textStyle="bold"/>

        <ImageView
            android:id="@+id/iv_coin"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_coin"/>
        <Button
            android:id="@+id/btn_coin"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:text="金币"
            android:textSize="22sp"
            android:background="#0066CC"
            android:textColor="#FFFFFF"
            android:elevation="5dp"/>
        <TextView
            android:id="@+id/tv_coin_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="28sp"
            android:textColor="#0066CC"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- 功能按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginTop="30dp">

        <Button
            android:id="@+id/btn_eat"
            android:layout_width="240dp"
            android:layout_height="70dp"
            android:text="吃什么"
            android:textSize="24sp"
            android:background="#0066CC"
            android:textColor="#FFFFFF"
            android:elevation="8dp"/>
        <Button
            android:id="@+id/btn_wear"
            android:layout_width="240dp"
            android:layout_height="70dp"
            android:layout_marginTop="25dp"
            android:text="穿什么"
            android:textSize="24sp"
            android:background="#0066CC"
            android:textColor="#FFFFFF"
            android:elevation="8dp"/>
        <Button
            android:id="@+id/btn_play"
            android:layout_width="240dp"
            android:layout_height="70dp"
            android:layout_marginTop="25dp"
            android:text="玩什么"
            android:textSize="24sp"
            android:background="#0066CC"
            android:textColor="#FFFFFF"
            android:elevation="8dp"/>

    </LinearLayout>

</LinearLayout>