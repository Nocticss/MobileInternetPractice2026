<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <EditText android:id="@+id/et_user" android:hint="输入账号" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <EditText android:id="@+id/et_pwd" android:hint="输入密码" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword"/>
    <EditText android:id="@+id/et_pwd2" android:hint="确认密码" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword"/>
    <Button android:id="@+id/btn_reg" android:text="注册" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/btn_go_login" android:text="去登录" android:layout_width="match_parent" android:layout_height="wrap_content"/>

</LinearLayout>